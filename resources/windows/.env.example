DB_PATH=bridge.db
OBS_WEBSOCKET_ADDRESS=127.0.0.1:4455
# Leave empty if auth is turned off in OBS.
OBS_WEBSOCKET_PASSWORD=
OBS_PROXY_SCENE_NAME=Proxy Scenes
# Optional, defaults to true. Stops hidden media sources decoding.
OBS_CLOSE_WHEN_INACTIVE=true
# Must match apiAddress in mediamtx.yml. If Windows refuses that port, move
# both to something free.
MEDIAMTX_API_ADDRESS=127.0.0.1:9997
# Must be reachable from the machine running OBS.
MEDIAMTX_RTMP_ADDRESS=127.0.0.1:1935
API_ADMIN_USERNAME=admin
API_ADMIN_PASSWORD=changeme
API_PORT=8080
