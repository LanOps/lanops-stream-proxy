# Copy to .env and fill in. docker compose reads this automatically.
OBS_WEBSOCKET_ADDRESS=127.0.0.1:4455
OBS_WEBSOCKET_PASSWORD=
OBS_PROXY_SCENE_NAME=Proxy Scenes
MEDIAMTX_API_ADDRESS=127.0.0.1:9997
# Reachable from the machine running OBS, not from the proxy container.
MEDIAMTX_RTMP_ADDRESS=127.0.0.1:1935
API_ADMIN_USERNAME=
API_ADMIN_PASSWORD=
API_PORT=8080
